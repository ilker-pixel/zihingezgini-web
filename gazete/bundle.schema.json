{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zihingezgini.net/gazete/bundle.schema.json",
  "title": "Gündem Gazetesi tamamlanmış bülten paketi v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bulletins"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "bulletins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/bulletin"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,95}$"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+(?:Z|[+-]\\d{2}:\\d{2})$"
    },
    "bulletin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feed_id",
        "bulletin_id",
        "scheduled_for",
        "completed_at",
        "coverage_start",
        "coverage_end",
        "topics"
      ],
      "properties": {
        "feed_id": {
          "enum": [
            "morning",
            "ai",
            "youtube_am",
            "youtube_pm"
          ]
        },
        "bulletin_id": {
          "$ref": "#/$defs/id"
        },
        "scheduled_for": {
          "$ref": "#/$defs/time"
        },
        "completed_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/time"
            }
          ]
        },
        "coverage_start": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/time"
            }
          ]
        },
        "coverage_end": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/time"
            }
          ]
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/topic"
          }
        },
        "prepared_at": {
          "$ref": "#/$defs/time"
        },
        "metadata": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "completed_at": {
                "type": "null"
              }
            }
          },
          "then": {
            "required": [
              "prepared_at"
            ]
          }
        }
      ]
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "title",
        "summary",
        "what_happened",
        "sources"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "category": {
          "enum": [
            "bilim",
            "teknoloji",
            "ekonomi",
            "dunya",
            "turkiye",
            "kultur",
            "saglik",
            "cevre",
            "spor",
            "felsefe",
            "hava"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Tek cümle"
        },
        "what_happened": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000,
          "description": "Mevcut kısa yazı metni; paragraflar ve kaynak çekinceleri aynen korunur"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "metadata": {
          "type": "object"
        },
        "full_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000,
          "description": "Özgün kaynak anlatımı, düz UTF-8; paragraflar boş satırlarla. Daha kısa veya aynıysa uzatılmaz; kaynakta yoksa alan eklenmez."
        },
        "full_text_sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/source"
          },
          "description": "Uzun anlatımın ek kaynakları; mevcut sources detay sayfasında da korunur."
        },
        "full_text_metadata": {
          "type": "object",
          "description": "Özgün başlık, kaynak zamanları, çekinceler, genel bakış, Bir çırpıda sayfaları ve halka açık kaynak kökeni."
        },
        "full_text_sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "items": {
            "$ref": "#/$defs/detail_section"
          }
        }
      },
      "dependentRequired": {
        "full_text_sources": [
          "full_text"
        ],
        "full_text_sections": [
          "full_text"
        ],
        "full_text_metadata": [
          "full_text"
        ]
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url",
        "published_at"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "maxLength": 2048
        },
        "published_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "$ref": "#/$defs/time"
            }
          ]
        }
      }
    },
    "detail_section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heading",
        "timestamp",
        "url",
        "paragraphs"
      ],
      "properties": {
        "heading": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 500
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:\\d{1,3}:)?\\d{1,3}:[0-5]\\d$"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://",
          "maxLength": 2048
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50000
          }
        },
        "warning": {
          "type": "boolean"
        }
      }
    }
  }
}
